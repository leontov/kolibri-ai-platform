{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.kolibriai.ru/v1/product/public-run-event-v2.schema.json",
  "title": "Kolibri provider-neutral public run event v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "event_id", "tenant_id", "run_id", "sequence", "type", "occurred_at", "payload"],
  "properties": {
    "schema_id": {"const": "kolibri.public_run_event"},
    "schema_version": {"const": "2.0"},
    "event_id": {"$ref": "#/definitions/opaque_id"},
    "tenant_id": {"$ref": "#/definitions/opaque_id"},
    "run_id": {"$ref": "#/definitions/opaque_id"},
    "sequence": {"type": "integer", "minimum": 1},
    "type": {
      "type": "string",
      "enum": [
        "RUN_ACCEPTED", "RUN_STARTED", "STATUS_CHANGED", "PUBLIC_PROGRESS",
        "TEXT_MESSAGE_START", "TEXT_MESSAGE_CONTENT", "TEXT_MESSAGE_END",
        "ACTIVITY_STARTED", "ACTIVITY_COMPLETED", "APPROVAL_REQUIRED",
        "ARTIFACT_CREATED", "ARTIFACT_UPDATED", "RUN_FINISHED", "RUN_ERROR",
        "RUN_CANCELLED"
      ]
    },
    "occurred_at": {"type": "string", "format": "date-time"},
    "payload": {"type": "object", "maxProperties": 32},
    "trace": {
      "type": "object", "additionalProperties": false,
      "required": ["trace_id", "span_id", "correlation_id"],
      "properties": {
        "trace_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
        "span_id": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
        "correlation_id": {"$ref": "#/definitions/opaque_id"}
      }
    }
  },
  "definitions": {
    "opaque_id": {"type": "string", "minLength": 8, "maxLength": 160, "pattern": "^[a-z][a-z0-9_]{1,31}_[A-Za-z0-9][A-Za-z0-9._~-]{5,127}$"}
  }
}
