{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.kolibriai.ru/v1/product/run-request-v2.schema.json",
  "title": "Kolibri provider-neutral run request v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id", "schema_version", "tenant_id", "user_id", "project_id",
    "thread_id", "run_id", "assistant_binding", "conversation_references",
    "project_context_references", "attachment_references",
    "requested_artifact_schemas", "locale", "timezone", "access_policy",
    "idempotency_key", "trace", "authority"
  ],
  "properties": {
    "schema_id": {"const": "kolibri.run_request"},
    "schema_version": {"const": "2.0"},
    "tenant_id": {"$ref": "#/definitions/opaque_id"},
    "user_id": {"$ref": "#/definitions/opaque_id"},
    "project_id": {"$ref": "#/definitions/opaque_id"},
    "thread_id": {"$ref": "#/definitions/opaque_id"},
    "run_id": {"$ref": "#/definitions/opaque_id"},
    "assistant_binding": {
      "type": "object", "additionalProperties": false,
      "required": [
        "assistant_id", "assistant_version", "assistant_manifest_hash",
        "runtime_profile", "node_id", "node_pool", "selected_skills",
        "skill_manifest_hash", "model_selection", "workspace_binding",
        "assignment_hash"
      ],
      "properties": {
        "assistant_id": {"$ref": "#/definitions/bounded_id"},
        "assistant_version": {"type": "integer", "minimum": 1},
        "assistant_manifest_hash": {"$ref": "#/definitions/sha256"},
        "runtime_profile": {"$ref": "#/definitions/bounded_id"},
        "node_id": {"$ref": "#/definitions/bounded_id"},
        "node_pool": {"$ref": "#/definitions/bounded_id"},
        "selected_skills": {
          "type": "array", "maxItems": 64, "uniqueItems": true,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["skill_id", "version", "content_hash"],
            "properties": {
              "skill_id": {"$ref": "#/definitions/bounded_id"},
              "version": {"type": "string", "minLength": 1, "maxLength": 64},
              "content_hash": {"$ref": "#/definitions/sha256"}
            }
          }
        },
        "skill_manifest_hash": {"$ref": "#/definitions/sha256"},
        "model_selection": {
          "type": "object", "additionalProperties": false,
          "required": ["model_id", "reasoning_effort", "service_tier"],
          "properties": {
            "model_id": {"type": ["string", "null"], "maxLength": 160},
            "reasoning_effort": {"type": ["string", "null"], "maxLength": 32},
            "service_tier": {"type": ["string", "null"], "maxLength": 64}
          }
        },
        "workspace_binding": {"$ref": "#/definitions/opaque_id"},
        "assignment_hash": {"$ref": "#/definitions/sha256"}
      }
    },
    "conversation_references": {"type": "array", "maxItems": 512, "uniqueItems": true, "items": {"$ref": "#/definitions/opaque_id"}},
    "project_context_references": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 2048}},
    "attachment_references": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/definitions/opaque_id"}},
    "requested_artifact_schemas": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "minLength": 3, "maxLength": 160, "pattern": "^[a-z][a-z0-9._-]{2,159}$"}},
    "locale": {"type": "string", "minLength": 2, "maxLength": 35, "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"},
    "timezone": {"type": "string", "minLength": 3, "maxLength": 64, "pattern": "^[A-Za-z0-9_+.-]+(?:/[A-Za-z0-9_+.-]+)*$"},
    "access_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "sandbox", "approval_policy", "allowed_tool_ids", "max_concurrency", "max_cost_minor", "currency"],
      "properties": {
        "mode": {"type": "string", "enum": ["standard", "auto", "full"]},
        "sandbox": {"type": "string", "enum": ["read-only", "workspace-write", "danger-full-access"]},
        "approval_policy": {"type": "string", "enum": ["never", "on-request"]},
        "allowed_tool_ids": {"type": "array", "maxItems": 128, "uniqueItems": true, "items": {"$ref": "#/definitions/bounded_id"}},
        "max_concurrency": {"type": "integer", "minimum": 1, "maximum": 32},
        "max_cost_minor": {"type": "integer", "minimum": 0},
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}
      }
    },
    "idempotency_key": {"type": "string", "minLength": 8, "maxLength": 256},
    "trace": {
      "type": "object", "additionalProperties": false,
      "required": ["trace_id", "span_id", "correlation_id", "causation_id"],
      "properties": {
        "trace_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
        "span_id": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
        "correlation_id": {"$ref": "#/definitions/opaque_id"},
        "causation_id": {"$ref": "#/definitions/opaque_id"}
      }
    },
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["issuer", "issued_at", "expires_at", "key_id", "signature"],
      "properties": {
        "issuer": {"const": "logical_home_control_plane"},
        "issued_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"},
        "key_id": {"$ref": "#/definitions/bounded_id"},
        "signature": {"type": "string", "pattern": "^hmac-sha256:[0-9a-f]{64}$"}
      }
    }
  },
  "definitions": {
    "opaque_id": {"type": "string", "minLength": 8, "maxLength": 160, "pattern": "^[a-z][a-z0-9_]{1,31}_[A-Za-z0-9][A-Za-z0-9._~-]{5,127}$"},
    "bounded_id": {"type": "string", "minLength": 2, "maxLength": 96, "pattern": "^[a-z0-9][a-z0-9._-]{1,95}$"},
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
